# The Mac App Store build's identity. Scripts/build-app.sh --mas and Scripts/package-mas.sh read this.
# Same name and id as the website build (Scripts/share/share.env): one app in two places. The two builds
# are signed differently, so macOS asks for the sound permission again and keeps their data apart.
# Values marked CHANGE: put your own (and your own name and app id for a build you publish; see ASSETS.md).
MAS_NAME="ADHD Music"
MAS_BUNDLE_ID="app.adhdmusic.mac"
MAS_VERSION="1.0"
MAS_BUILD_NUMBER="1"        # raise for every upload to App Store Connect
MAS_TEAM_ID="YOUR_TEAM_ID"  # CHANGE

# CHANGE: made once in the developer account (see Scripts/mas/README.md). package-mas.sh also accepts the older
# "3rd Party Mac Developer Application" name for the app certificate.
MAS_APP_SIGN_IDENTITY="Apple Distribution: YOUR NAME (YOUR_TEAM_ID)"
MAS_INSTALLER_SIGN_IDENTITY="3rd Party Mac Developer Installer: YOUR NAME (YOUR_TEAM_ID)"
# The "Mac App Store Connect" provisioning profile for your app id, downloaded from the developer site.
# Kept out of the repository (it names the team; .gitignore leaves out *.provisionprofile); the path is
# relative to the project folder.
MAS_PROFILE="Scripts/mas/ADHD_Music_Mac_App_Store.provisionprofile"

# Upload credentials for `xcrun altool`, one of the two (nothing secret is stored here):
#   an App Store Connect API key: MAS_API_KEY_ID + MAS_API_ISSUER_ID, with AuthKey_<id>.p8 in ~/.appstoreconnect/private_keys
#   or an app-specific password saved once with
#     xcrun altool --store-password-in-keychain-item "ADHD Music App Store" -u <Apple ID> -p <app-specific password>
MAS_API_KEY_ID=""
MAS_API_ISSUER_ID=""
MAS_UPLOAD_KEYCHAIN_ITEM="ADHD Music App Store"
