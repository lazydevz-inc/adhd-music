<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The website build from 1.0.1 on (SHARE_SANDBOX=1): App Sandbox like the Mac App Store build, so both use
	     the same data folder (~/Library/Containers/<id>) when both are installed. Scripts/build-app.sh puts the
	     bundle id in place of __BUNDLE_ID__.
	     audio-input: hearing other apps through Core Audio taps. camera: noticing a video call by the camera
	     (the store build leaves this out). network.client and the two mach-lookup names: Sparkle checks the feed
	     and starts its installer from inside the sandbox (sparkle-project.org/documentation/sandboxing). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>__BUNDLE_ID__-spks</string>
		<string>__BUNDLE_ID__-spki</string>
	</array>
</dict>
</plist>
