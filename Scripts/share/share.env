# The shared (free, website) build's identity. Scripts/build-app.sh --share and Scripts/package-share.sh read this.
#
# Values marked CHANGE: put your own before you build. Scripts/build-app.sh --share stops while the signing
# identity is still a placeholder, and Scripts/package-share.sh stops while the Sparkle account is.
#
# The name, app id, feed and public key below are the released ADHD Music app's. If you share a build of your
# own, change those too: the name "ADHD Music" and the icon are not licensed to you (ASSETS.md); the same app id
# would read and overwrite the released app's settings, records, likes and learning on the same Mac; and with
# the released feed and key your copy would look for its updates on adhdmusic.app.
SHARE_NAME="ADHD Music"
SHARE_BUNDLE_ID="app.adhdmusic.mac"
# Each release: raise SHARE_BUILD (Sparkle compares it; never reuse one) and set SHARE_VERSION (what people see).
SHARE_VERSION="1.0.1"
SHARE_BUILD="3"
# CHANGE: your Developer ID Application certificate, as `security find-identity -v -p codesigning` shows it.
SHARE_SIGN_IDENTITY="Developer ID Application: YOUR NAME (YOUR_TEAM_ID)"
# CHANGE: your notarytool keychain profile, made once with
#   xcrun notarytool store-credentials "<profile name>" --team-id <YOUR_TEAM_ID>
# Without it, package-share.sh notarizes through Xcode's signed-in account instead.
SHARE_NOTARY_PROFILE="YOUR_NOTARY_PROFILE"
# 1 from 1.0.1 on: App Sandbox (Scripts/share/entitlements-sandbox.plist), Sparkle's sandbox installer, earlier data
# moved into the container on first launch, and a signing rule the App Store copy also meets. 0 = like 1.0 build 2 (tests only).
SHARE_SANDBOX="1"

# Automatic updates (Sparkle 2, website build only; never the store build).
# The framework and tools live in build/vendor/Sparkle-$SPARKLE_VERSION (Scripts/share/get-sparkle.sh fetches them).
SPARKLE_VERSION="2.10.1"
SPARKLE_SHA256="1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27"
# The feed the app reads once a day, and where the files it lists (dmgs and deltas) are served.
SHARE_FEED_URL="https://adhdmusic.app/appcast.xml"
SHARE_UPDATES_URL="https://adhdmusic.app/updates/"
# CHANGE: the login keychain account that holds your private EdDSA key, made once with
#   build/vendor/Sparkle-$SPARKLE_VERSION/bin/generate_keys --account <name>
# generate_keys prints the public half: put it in SHARE_SPARKLE_PUBLIC_KEY (it goes into Info.plist).
# Back up the private key: losing it means installed copies can't update any more.
SHARE_SPARKLE_ACCOUNT="YOUR_SPARKLE_KEY_ACCOUNT"
# The released app's public key (public by design). Replace it with your own for a build you share.
SHARE_SPARKLE_PUBLIC_KEY="sAjx/0EwiU+QKvo7g/cqh6I7sj+S8rokHkQ80Q3+Ee8="
# Deltas from this many earlier versions to the newest, so people who skip versions don't fetch the whole app.
SHARE_MAX_DELTAS="20"

# A test build can override any of the above, plus SHARE_DATA_FOLDER and SHARE_OUT_DIR / SHARE_UPDATES_DIR,
# by pointing SHARE_ENV_EXTRA at a file of its own (Scripts/share/update-test.sh does).
if [[ -n "${SHARE_ENV_EXTRA:-}" ]]; then source "$SHARE_ENV_EXTRA"; fi
