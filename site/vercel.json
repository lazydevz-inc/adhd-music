{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/lazydevz-inc/adhd-music/releases/latest/download/ADHD-Music.dmg",
      "permanent": false
    },
    {
      "source": "/updates/:file",
      "destination": "https://github.com/lazydevz-inc/adhd-music/releases/download/updates/:file",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/lazydevz-inc/adhd-music",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/appcast.xml",
      "destination": "/api/appcast"
    },
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/array/:path*",
      "destination": "https://us-assets.i.posthog.com/array/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
